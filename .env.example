# Telegram configuration
TELEGRAM_TOKEN=YOUR:TOKEN
# Email configuration
EMAIL_FROM=your@email.tld
EMAIL_PASSWORD=your-password

# SMTP configuration
SMTP_HOST=your_smtp_server
SMTP_PORT=123

# Optional: Telegram chat ID for delivery notices (titles only), error reports, and feedback from the web app
# (the web app sends feedback through TELEGRAM_TOKEN, so it needs both)
ADMIN_ID=

# Database shared by the bot and the web app (default: users.db in the working directory)
# DATABASE_URL=sqlite:///users.db

# --- Web app (Eselsohr) ---
# Where the site is served, with no trailing slash. Must match the address in the browser.
PUBLIC_URL=https://eselsohr.gunne.one
# Signs the session cookie; required with https. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Sign in with Google: Google Cloud Console > OAuth client (Web). Redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Telegram: @BotFather > your bot > Login Widget. Allowed URLs: <PUBLIC_URL> and <PUBLIC_URL>/api/auth/telegram/callback
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# 'log' prints sign-in codes instead of mailing them: local development only
# WEB_MAIL=smtp
# Where the shared gunne.one design system is served from (e.g. http://localhost:5001/ds/v1 for a local copy)
# G1_DS_URL=https://gunne.one/ds/v1
